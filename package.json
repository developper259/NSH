{
  "name": "nsh",
  "version": "1.0.0",
  "description": "NSH (NDL Syntax Highlighter)",
  "license": "ISC",
  "author": "developper259",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/cjs/server.js"
    },
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/build-esm-wrapper.js && node scripts/copy-themes.js",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "npm run build:cjs && node scripts/build-esm-wrapper.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.js",
    "test:package": "npm run build && node test/package.test.js",
    "benchmark": "npm run build && node --expose-gc benchmark/index.js",
    "benchmark:smoke": "npm run build && node benchmark/smoke.js",
    "benchmark:corpus": "npm run build && node --expose-gc benchmark/corpus.js",
    "benchmark:corpus:update": "npm run build && node --expose-gc benchmark/corpus.js --update",
    "prepare": "node scripts/prepare.js",
    "dev": "tsc --watch",
    "start": "npm run build && node scripts/cli.js",
    "socket": "npm run build && node scripts/socket-demo.js"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
